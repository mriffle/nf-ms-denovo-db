/**
 * # Parameters for nf-ms-denovo-db
 *
 * A Nextflow pipeline implementing the "denovo-db" metaproteomics protocol:
 * database search (Comet) + de novo sequencing (Casanovo), merged and mapped
 * to an annotated protein database via homology search (DIAMOND), with FDR
 * control by RESET. See resources/denovo-db.pdf for the method.
 */
params {
    /** \group{Input/Output Parameters} */

    /** \type{string} \required
     *  Path to the FASTA file containing the subset of proteins sequences to
     *  search.
     */
    fasta = null

    /** \type{string} \required
     *  The directory containing the mzML or raw files to search
     */
    spectra_dir = null

    /** \type{string} \required
     *  Location of the comet params file
     */
    comet_params = 'comet.params'

    /** \type{string} \required
     *  Location of the casanovo params file
     */
    casanovo_config_file = 'casanovo.yaml'

    /** \type{string} \required
     *  Location of the casanovo model weights file.
     *
     *  Must match params.images.casanovo -- weights and container are a pair,
     *  and changing one without the other breaks the run. The project has
     *  decided to move to Casanovo 5.2.0 (see SPECIFICATION.md section 10);
     *  that move is blocked on publishing a 5.2.0 image, at which point this
     *  becomes the Orbitrap weights for that release:
     *  .../releases/download/v5.2.0/casanovo_orbitrap_v5-2-0.ckpt
     */
    casanovo_weights = 'https://github.com/Noble-Lab/casanovo/releases/download/v4.2.0/casanovo_v4_2_0.ckpt'

    /** \type{string} \required
     *  Location of a FASTA containing well-annotated protein sequences
     *  E.g., 'fastas/swiss-prot.fasta'
     */
    annotated_fasta = './swissprot.fasta'

    fasta_cache_directory = './fasta_cache'
    diamond_cache_directory = './diamond_db_cache'
    mzml_cache_directory = './mzml_cache'

    /** \type{string} \required
     *  The comet decoy prefix to use when generating decoys for comet
     */
    comet_decoy_prefix = 'COMET_DECOY_'

    /** \type{string} \required
     *  The annotated library decoy prefix to use for homology search of annotated database step
     */
    library_decoy_prefix = 'LIBRARY_DECOY_'

    /** \type{string} \required
     *  Search engine for homology search, must be one of:
     * 'diamond'. Default: 'diamond'
     */
    homology_search_engine = 'diamond'

    /** \type{int} \required
     *  Gap initiation penalty used by homology search
     */
    homology_search.gap_initiation_penalty = 6

    /** \type{int} \required
     *  Gap extension penalty used by homology search
     */
    homology_search.gap_extension_penalty = 2

    /** \type{boolean} \required
     *  Whether or not to use available GPUs. Set to false if no GPUs are available.
     */
    use_gpus = false

    /** \type{boolean} \required
     *  If true, CUDA_LAUNCH_BLOCKING=1 will be set to prevent errors on older GPUs. Do not use unless necessary, may degrade performance.
     */
    cuda_launch_blocking = false

    result_dir = 'results/nf-ms-denovo-db' /** \type{str} Where results will be saved. */
    report_dir = 'reports/nf-ms-denovo-db' /** \type{str} Where results will be saved. */
    email = null           /** \type{str} An email to alert on completion. */

    // Default resource ceilings. Override per-profile (see `standard`/`test`).
    // Consumed by process.resourceLimits in conf/base.config.
    max_memory = '128.GB'
    max_cpus   = 16
    max_time   = '240.h'

}

plugins {
    id 'nf-amazon'
}

docker {
    enabled = true
}

// Execution Profiles
profiles {

    /*
     * Params for running pipeline on the local computer (e.g.:
     * your laptop). These can be overridden in the local config file.
     */
    standard {
        process.executor = 'local'

        // limit nextflow to running 1 task at a time
        executor.queueSize = 1

        params.max_memory = '12.GB'
        params.max_cpus = 8
        params.max_time = '240.h'

        // where to cache mzml files after running msconvert
        params.mzml_cache_directory = '/data/mass_spec/nextflow/nf-ms-denovo-db/mzml_cache'
    }

    /*
     * Lightweight stub profile: runs every process' `stub:` block with no
     * containers and tiny fixtures. Used by tests/stub_test.sh and CI to verify
     * the DAG wiring end-to-end. Run with: `nextflow run . -profile test -stub`
     */
    test {
        process.executor   = 'local'
        docker.enabled     = false
        executor.queueSize = 4

        params.max_memory = '4.GB'
        params.max_cpus   = 2
        params.max_time   = '1.h'

        params.spectra_dir          = "${projectDir}/tests/data/spectra"
        params.fasta                = "${projectDir}/tests/data/subset.fasta"
        params.annotated_fasta      = "${projectDir}/tests/data/annotated.fasta"
        params.comet_params         = "${projectDir}/resources/comet.params"
        params.casanovo_config_file = "${projectDir}/tests/data/casanovo.yaml"
        params.casanovo_weights     = "${projectDir}/tests/data/weights.ckpt"

        params.mzml_cache_directory    = "${launchDir}/.test/mzml_cache"
        params.fasta_cache_directory   = "${launchDir}/.test/fasta_cache"
        params.diamond_cache_directory = "${launchDir}/.test/diamond_cache"

        params.result_dir = "${launchDir}/.test/results"
        params.report_dir = "${launchDir}/.test/reports"
    }

}

// Manifest
manifest {
    name            = 'ms-denovo-db'
    author          = 'Michael Riffle'
    homePage        = 'https://github.com/mriffle/nf-ms-denovo-db'
    description     = 'ms-denovo-db'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.04.0'
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Execution reports (overwrite on each run; the Nextflow 26 config parser does
// not allow a top-level `def` for a per-run timestamp).
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.report_dir}/execution_trace.txt"
}
dag {
    enabled   = false
    overwrite = true
    file      = "${params.report_dir}/pipeline_dag.html"
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load the images to use for all processes
includeConfig 'container_images.config'

// Limit Casanovo to one concurrent task when running on GPUs (avoid GPU
// contention). The Nextflow 26 config parser does not allow `if` statements,
// so this is expressed as a conditional value; `null` leaves the default
// (unlimited) when not running on GPUs.
process {
    withName: 'CASANOVO' {
        maxForks = params.use_gpus ? 1 : null
    }
}

// Completion email. Uses Nextflow's native notification scope (parser-safe and
// requires no custom Groovy). Configure SMTP via a `mail { }` block (see
// resources/pipeline.config). Enabled only when `params.email` is set.
notification {
    enabled = params.email != null
    to      = params.email
}
