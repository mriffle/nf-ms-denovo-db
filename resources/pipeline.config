/*
 * Example configuration for nf-ms-denovo-db.
 *
 * Copy this file, edit the paths/values for your data, and pass it with `-c`:
 *   nextflow run mriffle/nf-ms-denovo-db -c pipeline.config
 *
 * Only `fasta`, `spectra_dir`, and `annotated_fasta` are strictly required;
 * the rest have sensible defaults in nextflow.config.
 */
params {

    // ---- Input data ----

    // directory containing the mzML or .raw spectra files to search
    spectra_dir = '/path/to/spectra'

    // subset protein FASTA to search with Comet (the database-search step)
    fasta = '/path/to/subset.fasta'

    // well-annotated protein FASTA (e.g. Swiss-Prot) for the homology search
    annotated_fasta = '/path/to/swissprot.fasta'

    // ---- Search configuration ----

    // Comet parameters file (see resources/comet.params for a template)
    comet_params = './comet.params'

    // Casanovo config file
    casanovo_config_file = './casanovo.yaml'

    // Casanovo model weights: a local path or a URL. Download e.g. from
    //   https://github.com/Noble-Lab/casanovo/releases
    casanovo_weights = 'https://github.com/Noble-Lab/casanovo/releases/download/v4.2.0/casanovo_v4_2_0.ckpt'

    // decoy prefixes (must not collide with real protein accessions)
    comet_decoy_prefix   = 'COMET_DECOY_'
    library_decoy_prefix = 'LIBRARY_DECOY_'

    // homology search
    homology_search_engine = 'diamond'
    homology_search.gap_initiation_penalty = 6
    homology_search.gap_extension_penalty  = 2

    // ---- GPU ----
    use_gpus             = false  // set true when GPUs are available (speeds up Casanovo)
    cuda_launch_blocking = false  // only enable if you hit CUDA errors on older GPUs

    // receive an email when the run completes (requires the mail{} block below)
    //email = 'your@email.com'

}

profiles {

    // params for running the pipeline locally
    standard {
        params.max_memory = '16.GB'
        params.max_cpus   = 8
        params.max_time   = '240.h'

        // where to cache msconvert output between runs
        params.mzml_cache_directory = '/data/mass_spec/nextflow/nf-ms-denovo-db/mzml_cache'
    }
}

mail {
    from = 'address@host.com'
    smtp.host = 'smtp.host.com'
    smtp.port = 587
    smtp.user = 'smpt_user'
    smtp.password = 'smtp_password'
    smtp.auth = true
    smtp.starttls.enable = true
    smtp.starttls.required = false
    mail.smtp.ssl.protocols = 'TLSv1.2'
}
